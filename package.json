{
  "name": "cnb-chatgpt-mcp",
  "version": "0.7.0",
  "private": true,
  "description": "CNB MCP Server for ChatGPT-driven repository development and CNB automation.",
  "main": "./dist/stdio.js",
  "bin": {
    "cnb-mcp-stdio": "dist/stdio.js",
    "cnb-mcp-streamable": "dist/streamable.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/streamable.js",
    "start:http": "node dist/streamable.js",
    "start:stdio": "node dist/stdio.js",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "format:check": "prettier --check src",
    "format:fix": "prettier --write src",
    "generate:schema": "npx --yes openapi-typescript@5.4.2 swagger.json -o src/schema.d.ts",
    "test:unit": "node --test tests/*.test.mjs",
    "check:openapi": "node scripts/check-openapi-contract.mjs",
    "check": "npm run generate:schema && npm run lint && npm run format:check && npm run build && npm run test:unit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/drawdy/cnb-chatgpt-mcp.git"
  },
  "homepage": "https://github.com/drawdy/cnb-chatgpt-mcp",
  "bugs": {
    "url": "https://github.com/drawdy/cnb-chatgpt-mcp/issues"
  },
  "keywords": [
    "cnb",
    "chatgpt",
    "model context protocol",
    "mcp",
    "repository automation"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18",
    "typescript": ">=5.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "axios": "1.8.2",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "winston": "3.19.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/express": "5.0.6",
    "@types/node": "^18",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.52.0"
  }
}
